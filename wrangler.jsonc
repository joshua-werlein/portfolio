{
  "name": "portfolio-worker",
  "main": "portfolio-worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-04-03",
  "keep_vars": true,
  "routes": [
    {
      "pattern": "api.joshuawerlein.com",
      "zone_name": "joshuawerlein.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "triggers": {
    "crons": [
      "0 14 */3 * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "kv_namespaces": [
    {
      "id": "1678cfff94c84377a599444eff71c07a",
      "binding": "ANALYTICS"
    }
  ],
  "ratelimits": [
    {
      "name": "ANALYZE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "b52b665f-2dec-424d-a9bb-aa8ae0b299b8"
    }
  ]
}